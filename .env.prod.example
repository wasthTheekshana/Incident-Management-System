# Copy to .env beside docker-compose.prod.yml (in ~/ims-stack) and fill in. Never commit the real file.
# Generate the two passwords with:  openssl rand -hex 24
# Use hex (letters and digits only): the database password is placed inside a connection URL.
POSTGRES_PASSWORD=
# Shared secret between the shared Nginx and the API (openssl rand -hex 32). The same value goes into the Nginx block.
PROXY_KEY=
REDIS_PASSWORD=
APP_URL=https://ims.testsys.shop
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CIMS <no-reply@testsys.shop>"
