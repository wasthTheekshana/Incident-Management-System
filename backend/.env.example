# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://cims:cims_dev_password@localhost:5433/cims?schema=public
REDIS_URL=redis://localhost:6380

# Public URL of the web app (used in email links) and the only origin allowed to call the API.
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Must be true in production (HTTPS only). Leave false only for local http development.
COOKIE_SECURE=false

UPLOAD_DIR=./storage/uploads

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CIMS <no-reply@example.com>"

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
